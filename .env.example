# chainlens — example environment file.
#
# Copy to `.env` (which is gitignored) and fill in only the keys you need.
# The library works with NO keys at all: the default Bitcoin and Ethereum
# providers use free public endpoints. Keys unlock the BYO-key adapters.
#
# API keys are never accepted as function arguments — they are read from the
# environment / Settings only, and are filtered out of logs and test fixtures.

# --- Bitcoin ---
# Optional; raises the rate limit ceiling on some Blockchair endpoints.
BLOCKCHAIR_API_KEY=

# --- Ethereum / EVM (Etherscan API V2: one key, 50+ chains) ---
# Free tier: ~5 req/s shared across all chains, 100k calls/day.
ETHERSCAN_API_KEY=

# Base URL for a self-hosted or third-party JSON-RPC node.
# Leave unset to use the built-in public default.
CHAINLENS_ETH_RPC_URL=

# --- Metrics (network-wide aggregates only — NOT per-address data) ---
# Glassnode free "Light" tier: 50 calls/day, 1d resolution, 14-day history.
GLASSNODE_API_KEY=

# --- Query / labels (relatively expensive; never on a default path) ---
DUNE_API_KEY=
NANSEN_API_KEY=

# --- Behaviour ---
# Cache directory for the RFC 9111 HTTP cache. Defaults to XDG cache home.
CHAINLENS_CACHE_DIR=
# Caching mode: live | offline
#   live    - use the cache and revalidate against the network when needed
#   offline - never touch the network; a cache miss is an error
CHAINLENS_CACHE_MODE=live
# Pathological only: set to 1 to disable all plugin discovery.
CHAINLENS_DISABLE_PLUGINS=
